import commons.commons
import commons.global

// ~~ Macro para quebrar e vender esmeraldas ~~
// devido ao bug do abrir bau no alt tab, fazer com que o player
// pare de quebrar blocos, essa macro foi feita utilizando o sistemas de loja.
// é nescessario um segundo player vip, crie uma loja privada, para armazenar as esmeraldas,
// assim, o player principal, não precisa abrir baus para pegar as esmeraldas.
// Caso nescessario, utilizar uma macro para transferir constantemente os coins
// das contas mineradoras para a conta que vender/compra esmeraldas.

// CONFIG
// Nome da Macro
str macro_name = "tool"
// Id do bloco a ser minerado
int block_id = 129
// Id do item dropado
int drop_id = 388
// Nome da home da mineradora com os baus
str home = "esmeralda"
// blocos minerados
global int total_blocks = 0
// blocos minerados, em tempo real o de cima é estimado, a cada ciclo completo, é atualizado para a real quantidade
global int real_total_blocks = -448

toggle_macro(macro_name)

function set_inventory()
	print("Verificando inventario inicial...")
    IF(%GUI%!="GUIINVENTORY");
        GUI("INVENTORY");
    ENDIF;

    int pickaxe_slot = 0
    int rep_slot = 0
    FOR(#slot,9,44);
        GETSLOTITEM(%#slot%,#item_id);
        // GETITEMINFO(%#item_id%,&item_name);

        IF(%#item_id%==278);
        	if(pickaxe_slot != 0)
				GUI()
        		raise("Mais de uma picareta no inventario!")
            endif
			
            pickaxe_slot = %#slot%

        ELSEIF(%#item_id%==57);
        	if(rep_slot != 0)
				GUI()
				raise("Mais de um slot de blocos de reparacao no inventario!")
			endif
        	rep_slot = %#slot%
		ELSEIF(%#item_id%==block_id);
			if((#slot < 36) || (#slot > 44))
				GUI()
				raise("Bloco de mineracao fora da hotbar!")
			endif;
		ELSEIF((%#item_id%!=0) && (%#item_id%!=drop_id));
			GUI()
			raise("Item invalido no inventario!")
		endif;
    NEXT;

    // Validar inventario
	if(pickaxe_slot == 0)
		GUI()
		raise("Sem picareta no inventario!")
	endif

	if(rep_slot == 0)
		warning("Sem bloco de reparacao no inventario!")
	endif

	// Organizar inventario
	if(pickaxe_slot != 36)
		SLOTCLICK(%pickaxe_slot%,L,FALSE);
	    WAIT(3t)
	    SLOTCLICK("36",L,FALSE);
	    WAIT(3t)
	endif;
	
	if(rep_slot != 35)
		SLOTCLICK(%rep_slot%,L,FALSE);
	    WAIT(3t)
	    SLOTCLICK("35",L,FALSE);
	    WAIT(3t)
	endif;
	GUI();
endfunction;


function fill_hotbar()
	print("Comprando minerios...")
	unset(#baus[])
	//#baus[0] = 310;
	//#baus[1] = 332;
	//#baus[2] = 1;
	//#baus[3] = 33;
	#baus[0] = 53;
	
	slot(8);
	wait(3t);
	if(%ITEM%==block_id)
		break;
	endif

	// ciclar até conseguir comprar
	do()
		FOREACH(#baus[],#bau);
			look("1", "%#bau%")
			wait(1t)

			// placa
			if(%HITID% == 68)
				key("use")
				wait(20t)
				slot(8);
				wait(20t);

				if(%ITEM%==block_id)
					break;
				endif
        	endif;
		next;
		if(%ITEM%==block_id)
			break;
		endif

		wait(600t)
	loop

	real_total_blocks = real_total_blocks + 448
	total_blocks = real_total_blocks
	slot(1)
	wait(5t)
endfunction;


function place_and_break()
	look("179","4")
	wait(1t)
	do(5)
		key("use")
		wait(1t)
		if((%YAW% != 179) || (%PITCH% != 4))
	        looks("179","4")
	        wait(1t)
	    endif
	loop

	slot(1)
    do()
	    bool c = false
		do(150)
		    key("attack")

		    if(%HITID%==49)
		    	total_blocks = total_blocks + 4
		    	c = true
		    	break;
		    endif

		    if((%YAW% != 179) || (%PITCH% != 4))
		        looks("179","4")
		        wait(0.2t)
		    endif
		loop

		if(c)
			update_label()
			break;
		else
			do(5)
				log("&4KeyAttack bugado!!")
				wait(1t)
				playsound(note.harp);
				wait(10t)
			loop
		endif
	loop
endfunction;
	

function sell_items()
	unset(#baus[])
	#baus[0] = 307;
	#baus[1] = 326;
	#baus[2] = 4;
	#baus[3] = 39;
	#baus[4] = 57;


	// vender
	do(5)
		FOREACH(#baus[],#bau);
			look("270", "%#bau%")
			wait(1t)

			// placa
			if(%HITID% == 68)
				key("attack")
				wait(12t)
			endif;
		next;
	loop
endfunction;


function update_label();
	str label_text = "&aEsmeraldas: &3%total_blocks%"
    setlabel("ore_label","%label_text%");
endfunction;

// Iniciar a macro
slot(1)
wait(1t)
// Fast load, nao abrir invetario se ja tiver uma picareta na 1 slot,
// assim evitando bug de não quebrar bloco
if(%ITEM%!=278)
	set_inventory()

	// Ir pra a home
	go_home("%home%")
endif

// desativar menu loja
command("/menuloja off")

do()
	int block_slot = 2
	do()
		slot(%block_slot%)
		wait(1t)
		if(%ITEM% != %block_id%)
			keydown("jump")
			wait(1t)
			keyup("jump")
			wait(20t)
			if(%ITEM% != %block_id%)
				INC(block_slot, 1)
				if(block_slot > 9)
					// vender itens
					print("Sem bloco na hotbar!")
					sell_items()
					break;
				endif
			endif
		endif

		place_and_break()

		// Checar durabilidade / reparar
	    IF(%DURABILITY% < 450)
	        raise("&fFerramenta &4quebrando, &fparando macro...")
	    elseif(%DURABILITY% < 460);
	    	print("Reparandot ferramenta...")
	    	look("268","86")
	    	wait(1t)
	    	key("use")
	    	wait(1t)
	    ENDIF
	loop;

	fill_hotbar()
loop
