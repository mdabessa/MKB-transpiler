import commons.commons

function stock_item(#item_id,&stock_home);
	if(!&stock_home)
		&stock_home = "guardar"
	endif
	

	go_home("%&stock_home%")

	// verificar se ultimo bau ja esta cheio
	look("1","50")
	wait(2t)
	key("use")
	wait(5t)
	GETSLOTITEM(53,#item)
	wait(1t)
	gui();

	if(#item != 0)
		// bau cheio
		go_home("%&stock_home%_temp")
	elseif
		// bau vazio
		// set_home("%&stock_home%_temp")
	endif;

	unset(#chests[])
	#chests[0] = 316;
	#chests[1] = 333;
	#chests[2] = 9;
	#chests[3] = 33;
	#chests[4] = 51;

	// 54 -> 89 Inventario | 0 -> 53 Bau
	do()
	    FOREACH(#chests[],#chest);
			is_chest_full = false

		    look("1","%#chest%")
		    wait(1t)

		    if((%HITID% != 54) && (%HITID% != 146))
		    	log("&4Sem baus / Trap incompleta")
		    	stop()
		    endif

		    key("use")
		    wait(10t)
	    	
	    	FOR(#slot,54,89)
		        GETSLOTITEM("53",#last_chest_slot)
		        //GETITEMINFO(%#last_chest_slot%,&chest_name);

		        if(#last_chest_slot != 0)
		            is_chest_full = true
		            break
		        endif

		        GETSLOTITEM(%#slot%,#item_id_);
		        //GETITEMINFO(%#item_id_%,&item_name);

		        if(#item_id == #item_id_)
		            SLOTCLICK(%#slot%,L,TRUE);
		            WAIT(1t);               
		        endif
		    next

			gui()

			// bau não está cheio e não tem mais itens para guardar
		    if(!is_chest_full)
		    	break; 
		    endif;
	    next;

		if(!is_chest_full); 
			break;
		endif;
	    

	    // Proxima coluna
		// verificar se é o fim da trap mkb bau infinito
		look("90","56")
		wait(2t);
		#diff = %YPOS% - %HITY%
		if(#diff != 1)
			// fim da trap
			log("&4Fim da trap")
			stop()
		endif

		look("1","317")
		wait(2t)

		#last_x = %HITX%
	    #last_z = %HITZ%
	    #last_y = %HITY%

	    do()
	        keydown("right")
	        keydown("sneak")
	        wait(1t)
	        if((#last_z != %HITZ%) || (#last_x != %HITX%) || (#last_y != %HITY%))
	           	if((%HITID% == 54) || (%HITID% == 146))
		            keyup("right")
		            keyup("sneak")
	            	break
	            endif
	        endif
	    loop

	    set_home("%&stock_home%_temp")
	loop
endfunction;


function withdraw_item(#item_id,&stock_home="guardar",#max=36,stop_=true,temp_home=true,fast_inv=true)
	go_home("%&stock_home%")

	// isso pode bugar caso o stock for de mais de um tipo de item
	if(temp_home)
		// verificar se ultimo bau ja esta vazio
		look("1","50")
		wait(2t)
		key("use")
		wait(5t)
		GETSLOTITEM(53,#item)
		wait(1t)
		gui();

		if(#item == 0)
			// bau vazio
			go_home("%&stock_home%_temp")
		elseif
			// bau cheio
			set_home("%&stock_home%_temp")
		endif;
	endif

	unset(#chests[])
	#chests[0] = 316;
	#chests[1] = 333;
	#chests[2] = 9;
	#chests[3] = 33;
	#chests[4] = 51;

	// 54 -> 89 Inventario | 0 -> 53 Bau
	do()
	    FOREACH(#chests[],#chest);
			is_inventory_full = false

		    look("1","%#chest%")
		    wait(1t)

		    if((%HITID% != 54) && (%HITID% != 146))
		    	log("&4Sem baus / Trap incompleta")
		    	stop()
		    endif

		    key("use")
		    wait(10t)
	    	
	    	GETSLOTITEM("53",#item_id_)
	    	if(!fast_inv)
	    		#item_id_ = 1
	    	endif
	    	if(#item_id_ != 0)
		    	FOR(#slot,0,53)
		    		GETSLOTITEM(%#slot%,#item_id_)
			        //GETITEMINFO(%#item_id_%,&item_name);

			        if(#item_id == #item_id_)
			            SLOTCLICK(%#slot%,L,TRUE);
			            WAIT(1t);
			            #max = #max - 1
			        endif

		    		GETSLOTITEM(%#slot%,#item_id_)
			        if((#item_id_ != 0) || (#max = 0))
			            is_inventory_full = true
			            break
			        endif
			    next
			endif

		    gui()

		    if(is_inventory_full)
		    	break
		    endif
		next;

		if(is_inventory_full)
			break
		endif

		// Proxima coluna
		// verificar se é o fim da trap mkb bau infinito
		look("90","56")
		wait(2t);
		#diff = %YPOS% - %HITY%
		if(#diff != 1)
			// fim da trap
			if(stop_)
				log("&4Fim da trap")
				stop()
			endif
			break;
		endif

		look("1","317")
		wait(2t)

		#last_x = %HITX%
	    #last_z = %HITZ%
	    #last_y = %HITY%

	    do()
	        keydown("right")
	        keydown("sneak")
	        wait(1t)
	        if((#last_z != %HITZ%) || (#last_x != %HITX%) || (#last_y != %HITY%))
	           	if((%HITID% == 54) || (%HITID% == 146))
		            keyup("right")
		            keyup("sneak")
	            	break
	            endif
	        endif
	    loop

	    if(temp_home)
	    	set_home("%&stock_home%_temp")
		endif;
	loop
endfunction;
