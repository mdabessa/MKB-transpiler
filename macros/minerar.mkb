if(on){
    toggle(on);
    log("OFF!");
elseif
    toggle(on);
    log("ON!");
}

if(!on){
	keyup("forward");
    stop();
}


log("&6Iniciando mineracao...");
DO(){
    keydown("sneak");
    keydown("forward");
if(%HITY% >= %YPOS%){
        key("attack");
}

IF(%DURABILITY% < 100){
        log("DURABILITY LOW!");
        stop();
}
}
