$${
import commons.global

// 	Login e inciar macros ao entrar no server.
@#money = 0
@#tick_total = 0
@#money_chang1e = 0

@&main_nickname = "zaaaht"
&senha = ""

echo("/login %&senha%")
wait(1)
echo("/menuloja off")
wait(1)
echo("/pvp off")
wait(1)

wait(5000ms);
echo("/money")
wait(3000ms);

// Redefinir o @#money_change apos atualizar o @#money 
set(@#money_change, 0)
wait(1000ms);
echo("/money")
wait(1000ms);

// Religar todos os macros que estavam ativos
reload()

}$$