import commons.global;

// 	Login e inciar macros ao entrar no server.
global int money = 0
global int tick_total = 0
global int money_chang1e = 0

global str main_nickname = "zaaaht"
str senha = ""

echo("/login %senha%");
wait(1);
echo("/menuloja off");
wait(1);
echo("/pvp off");
wait(1);

wait(5000ms);
echo("/money");
wait(3000ms);

// Redefinir o @#money_change apos atualizar o @#money 
set(@#money_change, 0);
wait(1000ms);
echo("/money");
wait(1000ms);

// Religar todos os macros que estavam ativos
reload();
