if(@#pos_x == null){
    @#pos_x = %XPOS%
    global int pos_y = %YPOS%
    global int pos_z = %ZPOS%
	
	log("&6Posicao inicial: X&5%@#pos_x% &6Y&5%pos_y% &6Z&5%pos_z%");
	log("&6Aperte novamente para calcular a distancia...");
elseif
    int diffx = %XPOS% - @#pos_x
    int diffy = %YPOS% - pos_y
    int diffz = %ZPOS% - pos_z

if(diffx < 0){
		diffx = diffx * -1
}
if(diffy < 0){
		diffy = diffy * -1
}
if(diffz < 0){
		diffz = diffz * -1
}
	
	int a = diffx * diffx
	int b = diffy * diffy
	int c = diffz * diffz
	int d = a + b + c

	log("%d%");
	int dist = sqrt(d)

	log("&6Posicao final: X&5%XPOS% &6Y&5%YPOS% &6Z&5%ZPOS%");
	log("&6Diferenca: X&5%diffx% &6Y&5%diffy% &6Z&5%diffz%");
	log("&6Distancia: &5%dist% &6blocos");

	unset(@#pos_x);
	unset(pos_y);
	unset(pos_z);
}
