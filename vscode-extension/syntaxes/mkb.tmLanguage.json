{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MKB",
  "scopeName": "source.mkb",
  "patterns": [
    { "include": "#comments" },
    { "include": "#markers" },
    { "include": "#strings" },
    { "include": "#interpolation" },
    { "include": "#typed-declarations" },
    { "include": "#declarations" },
    { "include": "#typed-parameters" },
    { "include": "#calls" },
    { "include": "#block-keywords" },
    { "include": "#braces" },
    { "include": "#variables" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.mkb"
    },
    "markers": {
      "match": "\\$\\$\\{|\\}\\$\\$",
      "name": "punctuation.section.macro.mkb"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.mkb",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "match": "%(@?[#&]?)([A-Za-z_][A-Za-z0-9_]*)(\\[\\\\])?%",
      "captures": {
        "1": { "name": "punctuation.definition.variable.mkb" },
        "2": { "name": "variable.other.interpolated.mkb" }
      }
    },
    "declarations": {
      "match": "\\b(import|function|endfunction)\\b",
      "name": "keyword.control.declaration.mkb"
    },
    "typed-declarations": {
      "match": "^([ \\t]*)(?:(global)[ \\t]+)?(int|num|number|float|double|long|str|string|text|bool|boolean)([ \\t]*\\[\\s*\\])?[ \\t]+([#&@]{0,2}[A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "2": { "name": "storage.modifier.global.mkb" },
        "3": { "name": "storage.type.mkb" },
        "4": { "name": "punctuation.definition.array.mkb" },
        "5": { "name": "variable.other.declared.mkb" }
      }
    },
    "typed-parameters": {
      "match": "(?<!\\w)(?:(global)\\s+)?(int|num|number|float|double|long|str|string|text|bool|boolean)(\\s*\\[\\s*\\])?\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[,)=;=])",
      "captures": {
        "1": { "name": "storage.modifier.global.mkb" },
        "2": { "name": "storage.type.mkb" },
        "3": { "name": "punctuation.definition.array.mkb" },
        "4": { "name": "variable.parameter.mkb" }
      }
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "support.function.mkb" }
      }
    },
    "block-keywords": {
      "match": "\\b(?:endif|else|elseif|loop|next|endfunction|endunsafe|break)\\b",
      "name": "keyword.control.mkb"
    },
    "braces": {
      "patterns": [
        {
          "match": "(\\{)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.brace.mkb" }
          }
        },
        {
          "match": "(\\})",
          "captures": {
            "1": { "name": "keyword.control.brace.mkb" }
          }
        }
      ]
    },
    "variables": {
      "match": "(@[#&]?|#|&)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.variable.mkb" },
        "2": { "name": "variable.other.mkb" }
      }
    },
    "numbers": {
      "match": "\\b\\d+(_\\d+)*((?:ms|t))?\\b",
      "name": "constant.numeric.mkb"
    }
  }
}